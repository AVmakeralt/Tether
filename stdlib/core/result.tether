// std/core/result.tether — Result<T, E>

module std::core::result

enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    fn is_ok(self) -> bool {
        match self {
            Ok(_)  => true,
            Err(_) => false,
        }
    }

    fn is_err(self) -> bool {
        match self {
            Ok(_)  => false,
            Err(_) => true,
        }
    }

    fn unwrap(self) -> T {
        match self {
            Ok(v)  => v,
            Err(_) => unsafe { unreachable() },
        }
    }

    fn unwrap_or(self, default: T) -> T {
        match self {
            Ok(v)  => v,
            Err(_) => default,
        }
    }

    fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        match self {
            Ok(v)  => Ok(f(v)),
            Err(e) => Err(e),
        }
    }

    fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> {
        match self {
            Ok(v)  => Ok(v),
            Err(e) => Err(f(e)),
        }
    }

    fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Ok(v)  => f(v),
            Err(e) => Err(e),
        }
    }
}

extern fn unreachable() -> i64
