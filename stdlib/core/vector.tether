// std/core/vector.tether — growable vector
//
// A contiguous, growable array. Backed by heap allocation.

module std::core::vector

struct Vector<T> {
    ptr: *mut T,
    len: u64,
    cap: u64,
}

impl<T> Vector<T> {
    fn new() -> Vector<T> {
        return Vector { ptr: 0 as *mut T, len: 0, cap: 0 }
    }

    fn with_capacity(cap: u64) -> Vector<T> {
        unsafe {
            let p = malloc(cap * sizeof<T>()) as *mut T
            return Vector { ptr: p, len: 0, cap: cap }
        }
    }

    fn len(self) -> u64 {
        return self.len
    }

    fn is_empty(self) -> bool {
        return self.len == 0
    }

    fn push(self, val: T) {
        if self.len >= self.cap {
            self.grow()
        }
        unsafe {
            *(self.ptr + self.len) = val
        }
        self.len = self.len + 1
    }

    fn pop(self) -> Option<T> {
        if self.len == 0 {
            return None
        }
        self.len = self.len - 1
        unsafe {
            return Some(*(self.ptr + self.len))
        }
    }

    fn get(self, index: u64) -> Option<T> {
        if index < self.len {
            unsafe {
                return Some(*(self.ptr + index))
            }
        }
        return None
    }

    fn clear(self) {
        self.len = 0
    }

    fn grow(self) {
        let new_cap = if self.cap == 0 { 4 } else { self.cap * 2 }
        unsafe {
            let new_ptr = realloc(self.ptr as *mut u8, new_cap * sizeof<T>()) as *mut T
            self.ptr = new_ptr
            self.cap = new_cap
        }
    }

    fn drop(self) {
        unsafe {
            if self.cap > 0 {
                free(self.ptr as *mut u8)
            }
        }
    }
}

extern fn malloc(size: u64) -> *mut u8
extern fn free(ptr: *mut u8)
extern fn realloc(ptr: *mut u8, size: u64) -> *mut u8
extern fn sizeof<T>() -> u64
