// std/core/option.tether — Option<T>

module std::core::option

enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    fn is_some(self) -> bool {
        match self {
            Some(_) => true,
            None    => false,
        }
    }

    fn is_none(self) -> bool {
        match self {
            Some(_) => false,
            None    => true,
        }
    }

    fn unwrap(self) -> T {
        match self {
            Some(v) => v,
            None    => unsafe { unreachable() },
        }
    }

    fn unwrap_or(self, default: T) -> T {
        match self {
            Some(v) => v,
            None    => default,
        }
    }

    fn map<U>(self, f: fn(T) -> U) -> Option<U> {
        match self {
            Some(v) => Some(f(v)),
            None    => None,
        }
    }

    fn and_then<U>(self, f: fn(T) -> Option<U>) -> Option<U> {
        match self {
            Some(v) => f(v),
            None    => None,
        }
    }

    fn or(self, alt: Option<T>) -> Option<T> {
        match self {
            Some(_) => self,
            None    => alt,
        }
    }

    fn take(self) -> Option<T> {
        return self
    }
}

extern fn unreachable() -> i64
